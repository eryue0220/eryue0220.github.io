---
import "../styles/global.css";
import {
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_TITLE,
  SITE_URL,
} from "@/constant";

interface Props {
  title?: string;
  header?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  updatedTime?: Date;
  tags?: string[];
  lang?: string;
  markdownUrl?: string;
}

const {
  title: titleProp,
  header,
  description = SITE_DESCRIPTION,
  type = "website",
  publishedTime,
  updatedTime,
  tags = [],
  lang = SITE_LOCALE,
  markdownUrl,
} = Astro.props;

const pageName = titleProp ?? header ?? SITE_TITLE;
const pageTitle = pageName === SITE_TITLE ? SITE_TITLE : `${pageName} | ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const llmsUrl = new URL("/llms.txt", Astro.site).href;
const rssUrl = new URL("/rss.xml", Astro.site).href;
const markdownHref = markdownUrl ? new URL(markdownUrl, Astro.site).href : undefined;
const locale = lang.toLowerCase().startsWith("zh") ? "zh_CN" : "en_US";

const structuredData =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: pageName,
        description,
        datePublished: publishedTime?.toISOString(),
        dateModified: (updatedTime ?? publishedTime)?.toISOString(),
        inLanguage: lang,
        keywords: tags,
        author: {
          "@type": "Person",
          name: SITE_AUTHOR,
          url: SITE_URL,
        },
        publisher: {
          "@type": "Person",
          name: SITE_AUTHOR,
          url: SITE_URL,
        },
        mainEntityOfPage: canonical,
        url: canonical,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: SITE_URL,
        inLanguage: SITE_LOCALE,
        author: {
          "@type": "Person",
          name: SITE_AUTHOR,
          jobTitle: "Full-stack engineer",
          url: SITE_URL,
        },
      };
---

<html lang={lang.toLowerCase().startsWith("zh") ? "zh-CN" : lang.toLowerCase().startsWith("en") ? "en" : lang} class="bg-paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href={llmsUrl} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssUrl} />
    {markdownHref ? (
      <link rel="alternate" type="text/markdown" title="Markdown" href={markdownHref} />
    ) : null}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    {type === "article" && publishedTime ? (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    ) : null}
    {type === "article" && (updatedTime ?? publishedTime) ? (
      <meta property="article:modified_time" content={(updatedTime ?? publishedTime)!.toISOString()} />
    ) : null}
    {type === "article" ? tags.map((tag) => <meta property="article:tag" content={tag} />) : null}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <slot />
</html>
