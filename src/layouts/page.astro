---
import "../styles/global.css";

const { header } = Astro.props;
---

<html lang="en" class="bg-paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{header}</title>
  </head>
  <slot />
</html>
