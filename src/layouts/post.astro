---
import PageLayout from './page.astro'
import IndexLayout from './index.astro';

interface Props {
  header: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  tags?: string[];
  lang?: string;
  markdownUrl?: string;
}

const { header, ...seo } = Astro.props;
---

<PageLayout title={header} {...seo}>
  <IndexLayout>
    <slot />
  </IndexLayout>
</PageLayout>
