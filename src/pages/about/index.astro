---
import PageLayout from "@/layouts/page.astro";
import HomeLayout from "@/layouts/index.astro";
import Education from "@/components/education";
import Language from "@/components/language";
import Work from "@/components/work";
import Skill from "@/components/skill";
import { SITE_TITLE as title } from "@/constant";

import education from "../../../public/config/education.json";
import building from "../../../public/config/building.json";
import language from "../../../public/config/language.json";
import learn from "../../../public/config/learn.json";
import oss from "../../../public/config/oss.json";
import skill from "../../../public/config/skill.json";
import work from "../../../public/config/work.json";
---

<PageLayout header={title}>
  <HomeLayout title={title}>
    <div class="mx-auto w-full max-w-5xl px-5 text-[#24231f] sm:px-8">
      <!-- Experience -->
      {
        work && work?.content?.length ? (
          <section class="pt-10 sm:pt-14">
            <div class="mb-8 flex items-center gap-4">
              <span class="text-[.72rem] font-extrabold tracking-[.14em] text-[#e77643]">01</span>
              <h2 class="m-0 text-[1.55rem] font-extrabold tracking-[-.04em]">{work.title}</h2>
              <i class="h-px flex-1 bg-[#dedbd2]"></i>
            </div>
            <Work workExperience={work.content} client:visible />
          </section>
        ) : null
      }

      <!-- Building -->
      {
        building && building?.content?.length ? (
          <section class="pt-10 sm:pt-14">
            <div class="mb-8 flex items-center gap-4">
              <span class="text-[.72rem] font-extrabold tracking-[.14em] text-[#e77643]">02</span>
              <h2 class="m-0 text-[1.55rem] font-extrabold tracking-[-.04em]">{building.title}</h2>
              <i class="h-px flex-1 bg-[#dedbd2]"></i>
            </div>
            <Skill skills={building.content} />
          </section>
        ) : null
      }

      <!-- contribution -->
      {
        oss && oss?.content?.length ? (
          <section class="pt-10 sm:pt-14">
            <div class="mb-8 flex items-center gap-4">
              <span class="text-[.72rem] font-extrabold tracking-[.14em] text-[#e77643]">03</span>
              <h2 class="m-0 text-[1.55rem] font-extrabold tracking-[-.04em]">{oss.title}</h2>
              <i class="h-px flex-1 bg-[#dedbd2]"></i>
            </div>
            <Skill skills={oss.content} />
          </section>
        ) : null
      }

      <!-- Know -->
      {
        skill && skill?.content?.length ? (
          <section class="pt-10 sm:pt-14">
            <div class="mb-8 flex items-center gap-4">
              <span class="text-[.72rem] font-extrabold tracking-[.14em] text-[#e77643]">04</span>
              <h2 class="m-0 text-[1.55rem] font-extrabold tracking-[-.04em]">{skill.title}</h2>
              <i class="h-px flex-1 bg-[#dedbd2]"></i>
            </div>
            <Skill skills={skill.content} client:visible />
          </section>
        ) : null
      }

      <!-- Learn -->
      {
        learn && learn?.content?.length ? (
          <section class="pt-10 sm:pt-14">
            <div class="mb-8 flex items-center gap-4">
              <span class="text-[.72rem] font-extrabold tracking-[.14em] text-[#e77643]">05</span>
              <h2 class="m-0 text-[1.55rem] font-extrabold tracking-[-.04em]">{learn.title}</h2>
              <i class="h-px flex-1 bg-[#dedbd2]"></i>
            </div>
            <Skill skills={learn.content} client:visible />
          </section>
        ) : null
      }

      <!-- Education -->
      {
        education && education?.content?.length ? (
          <section class="pt-10 sm:pt-14">
            <div class="mb-8 flex items-center gap-4">
              <span class="text-[.72rem] font-extrabold tracking-[.14em] text-[#e77643]">06</span>
              <h2 class="m-0 text-[1.55rem] font-extrabold tracking-[-.04em]">{education?.title}</h2>
              <i class="h-px flex-1 bg-[#dedbd2]"></i>
            </div>
            <Education educations={education?.content || []} />
          </section>
        ) : null
      }

      <!-- Language -->
      {
        language && language?.content?.length ? (
          <section class="pt-10 sm:pt-14">
            <div class="mb-8 flex items-center gap-4">
              <span class="text-[.72rem] font-extrabold tracking-[.14em] text-[#e77643]">07</span>
              <h2 class="m-0 text-[1.55rem] font-extrabold tracking-[-.04em]">{language.title}</h2>
              <i class="h-px flex-1 bg-[#dedbd2]"></i>
            </div>
            <Language languages={language.content} />
          </section>
        ) : null
      }
    </div>
  </HomeLayout>
</PageLayout>
