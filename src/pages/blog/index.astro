---
import { type CollectionEntry, getCollection } from "astro:content";
import Page from "@/layouts/page.astro";
import BlogLayout from "@/layouts/blog.astro";
import { formatDate } from "@/utils";

const description = "Published notes on web engineering, observability, interviews, and related topics.";

type Post = CollectionEntry<"blog">;

const publishedPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .map((post) => ({
    ...post,
    data: {
      ...post.data,
      pubYear: formatDate(post.data.date).slice(0, 4),
      pubDate: formatDate(post.data.date),
    },
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const getTags = (post: Post) => [...new Set(post.data.tag.split(/\s+/).filter(Boolean))];
const tags = [...new Set(publishedPosts.flatMap(getTags))].sort((a, b) => a.localeCompare(b));
const posts = publishedPosts.reduce(
    (acc, cur) => {
      if (!acc[cur.data.pubYear]) {
        acc[cur.data.pubYear] = [];
      }
      acc[cur.data.pubYear].push(cur);
      return acc;
    },
    {} as Record<string, Post[]>,
  );

const postsKeys = Object.keys(posts).sort((a, b) => Number(b) - Number(a));
const isOnlyOne = postsKeys.length === 1;
---

<script>
  const blog = document.querySelector<HTMLElement>("[data-blog]");
  if (blog) {
    const filters = blog.querySelector<HTMLElement>("[data-tag-filters]")!;
    const buttons = filters.querySelectorAll<HTMLButtonElement>("[data-tag]");
    const groups = blog.querySelectorAll<HTMLElement>("[data-year]");
    const status = blog.querySelector<HTMLElement>("[data-filter-status]")!;

    const applyFilter = () => {
      const requestedTag = new URL(window.location.href).searchParams.get("tag") ?? "";
      const selectedTag = Array.from(buttons).some((button) => button.dataset.tag === requestedTag)
        ? requestedTag : "";
      let count = 0;
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.tag === selectedTag));
      });
      groups.forEach((group) => {
        let matches = 0;
        group.querySelectorAll<HTMLElement>("[data-post-tags]").forEach((post) => {
          const tags: string[] = JSON.parse(post.dataset.postTags!);
          const visible = !selectedTag || tags.includes(selectedTag);
          post.hidden = !visible;
          if (visible) matches++;
        });
        group.hidden = matches === 0;
        count += matches;
        const toggle = group.querySelector<HTMLButtonElement>("[data-year-toggle]");
        const list = group.querySelector<HTMLElement>("[data-year-posts]")!;
        list.hidden = false;
        toggle?.setAttribute("aria-expanded", "true");
      });
      status.textContent = `${count} ${count === 1 ? "post" : "posts"}${selectedTag ? ` tagged “${selectedTag}”` : ""}`;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const url = new URL(window.location.href);
        const tag = button.dataset.tag!;
        if (tag) url.searchParams.set("tag", tag);
        else url.searchParams.delete("tag");
        if (url.href !== window.location.href) window.history.pushState(null, "", url);
        applyFilter();
      });
    });
    blog.querySelectorAll<HTMLButtonElement>("[data-year-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const list = document.getElementById(toggle.getAttribute("aria-controls")!)!;
        list.hidden = !list.hidden;
        toggle.setAttribute("aria-expanded", String(!list.hidden));
      });
    });
    window.addEventListener("popstate", applyFilter);
    applyFilter();
    filters.hidden = false;
  }
</script>

<Page title="Blog" description={description} markdownUrl="/blog/index.md">
  <BlogLayout>
    <article data-blog class="grid grid-cols-[minmax(0,1fr)_clamp(7rem,22vw,10rem)] items-start gap-[clamp(1rem,4vw,2.5rem)] mx-auto py-20 px-4 sm:px-5 [&_[hidden]]:hidden! [&_button]:focus-visible:outline-2 [&_button]:focus-visible:outline-solid [&_button]:focus-visible:outline-accent [&_button]:focus-visible:outline-offset-3">

      <ul class="grid min-w-0 gap-10">
        {
          postsKeys.map((year) => (
            <li data-year={year}>
              <h1 class="text-2xl">
                {isOnlyOne ? <span class="pl-5">{year}</span> : (
                  <button
                    type="button"
                    data-year-toggle
                    aria-expanded="true"
                    aria-controls={`posts-${year}`}
                    class="pl-5 cursor-pointer relative before:content-[''] before:absolute before:left-[0.35rem] before:top-1/2 before:size-[0.4em] before:border-r-2 before:border-b-2 before:[transform:translateY(-70%)_rotate(-45deg)] before:transition-transform before:duration-150 before:ease-[ease] aria-expanded:before:[transform:translateY(-50%)_rotate(45deg)]"
                  >
                    {year}
                  </button>
                )}
              </h1>
              <ul
                id={`posts-${year}`}
                data-year-posts
                class="grid gap-4 mt-3 pl-8 text-lg [&>li]:grid [&>li]:grid-cols-[minmax(0,1fr)_auto] [&>li]:items-center [&>li]:gap-3 [&>li]:wrap-anywhere"
              >
                {posts[year].map((post: Post) => (
                  <li data-post-tags={JSON.stringify(getTags(post))}>
                    <a href={`/blog/${post.id}`} class="min-w-0">
                      <p>
                        {formatDate(post.data.date)} {post.data.title}
                      </p>
                    </a>
                    {post.data.lang ? (
                      <p class="border-2 border-dotted border-zinc-600 text-sm">
                        {post.data.lang?.toUpperCase()}
                      </p>
                    ) : null}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <aside data-tag-filters hidden aria-label="Tags" class="min-w-0 border-l border-line pl-[clamp(0.75rem,2vw,1.5rem)]">
        <div role="group" aria-label="Filter posts by tag" class="flex flex-col items-start gap-2">
          {["", ...tags].map((tag) => (
            <button
              type="button"
              data-tag={tag}
              aria-pressed={tag === "" ? "true" : "false"}
              class="max-w-full wrap-anywhere text-left rounded-full border border-line px-3 py-1 text-sm cursor-pointer hover:border-ink aria-pressed:bg-ink aria-pressed:border-ink aria-pressed:text-paper"
            >
              {tag || "All"}
            </button>
          ))}
        </div>
        <p data-filter-status role="status" aria-live="polite" class="mt-3 text-sm text-muted wrap-anywhere"></p>
      </aside>
    </article>
  </BlogLayout>
</Page>
