---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Post from '@/layouts/post.astro';
import { formatDate } from '@/utils';

export async function getStaticPaths() {
  const posts = await getCollection('weekly');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'weekly'>;

const post = Astro.props;
const { Content } = await render(post);
const { data } = post;
---

<Post header={data.title}>
  <article class="prose lg:prose-xl">
    <div class="flex items-center lg:p-0 mb-4">
			<p class="text-[#475569] text-sm lg:p-1 lg:my-0">{formatDate(data.date)}</p>
			<span class="text-[#475569]"> | </span>
			<p class="text-[#475569] text-sm lg:p-1 lg:my-0">{data.tag}</p>
		</div>
    <Content />
  </article>
</Post>
